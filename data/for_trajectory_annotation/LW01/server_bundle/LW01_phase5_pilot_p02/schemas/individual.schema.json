{
  "$id": "phase5-individual-annotation-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "causal_continuity": {
      "additionalProperties": false,
      "properties": {
        "evidence_paragraph_ids": {
          "items": {
            "pattern": "^[0-9]+$",
            "type": "string"
          },
          "maxItems": 4,
          "type": "array"
        },
        "justification": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "enum": [
            "continuous",
            "minor_gap",
            "broken",
            "unclear"
          ],
          "type": "string"
        }
      },
      "required": [
        "label",
        "justification",
        "evidence_paragraph_ids"
      ],
      "type": "object"
    },
    "perceived_profile": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "additionalProperties": false,
          "properties": {
            "counterevidence_choice_refs": {
              "items": {
                "pattern": "^S[0-9]{3}-C[0-9]{2}$",
                "type": "string"
              },
              "maxItems": 2,
              "type": "array"
            },
            "justification": {
              "maxLength": 1200,
              "minLength": 1,
              "type": "string"
            },
            "label": {
              "enum": [
                "physical",
                "neutral",
                "tactical",
                "unclear"
              ],
              "type": "string"
            },
            "support": {
              "enum": [
                "clear",
                "mixed",
                "insufficient"
              ],
              "type": "string"
            },
            "supporting_choice_refs": {
              "items": {
                "pattern": "^S[0-9]{3}-C[0-9]{2}$",
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            }
          },
          "required": [
            "label",
            "support",
            "justification",
            "supporting_choice_refs",
            "counterevidence_choice_refs"
          ],
          "type": "object"
        },
        "morality": {
          "additionalProperties": false,
          "properties": {
            "counterevidence_choice_refs": {
              "items": {
                "pattern": "^S[0-9]{3}-C[0-9]{2}$",
                "type": "string"
              },
              "maxItems": 2,
              "type": "array"
            },
            "justification": {
              "maxLength": 1200,
              "minLength": 1,
              "type": "string"
            },
            "label": {
              "enum": [
                "selfish",
                "neutral",
                "noble",
                "unclear"
              ],
              "type": "string"
            },
            "support": {
              "enum": [
                "clear",
                "mixed",
                "insufficient"
              ],
              "type": "string"
            },
            "supporting_choice_refs": {
              "items": {
                "pattern": "^S[0-9]{3}-C[0-9]{2}$",
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            }
          },
          "required": [
            "label",
            "support",
            "justification",
            "supporting_choice_refs",
            "counterevidence_choice_refs"
          ],
          "type": "object"
        },
        "risk": {
          "additionalProperties": false,
          "properties": {
            "counterevidence_choice_refs": {
              "items": {
                "pattern": "^S[0-9]{3}-C[0-9]{2}$",
                "type": "string"
              },
              "maxItems": 2,
              "type": "array"
            },
            "justification": {
              "maxLength": 1200,
              "minLength": 1,
              "type": "string"
            },
            "label": {
              "enum": [
                "cautious",
                "neutral",
                "reckless",
                "unclear"
              ],
              "type": "string"
            },
            "support": {
              "enum": [
                "clear",
                "mixed",
                "insufficient"
              ],
              "type": "string"
            },
            "supporting_choice_refs": {
              "items": {
                "pattern": "^S[0-9]{3}-C[0-9]{2}$",
                "type": "string"
              },
              "maxItems": 3,
              "type": "array"
            }
          },
          "required": [
            "label",
            "support",
            "justification",
            "supporting_choice_refs",
            "counterevidence_choice_refs"
          ],
          "type": "object"
        }
      },
      "required": [
        "risk",
        "morality",
        "action"
      ],
      "type": "object"
    },
    "profile_coherence": {
      "additionalProperties": false,
      "properties": {
        "counterevidence_choice_refs": {
          "items": {
            "pattern": "^S[0-9]{3}-C[0-9]{2}$",
            "type": "string"
          },
          "maxItems": 2,
          "type": "array"
        },
        "justification": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "enum": [
            "coherent",
            "mixed",
            "incoherent",
            "insufficient_evidence"
          ],
          "type": "string"
        },
        "supporting_choice_refs": {
          "items": {
            "pattern": "^S[0-9]{3}-C[0-9]{2}$",
            "type": "string"
          },
          "maxItems": 3,
          "type": "array"
        }
      },
      "required": [
        "label",
        "justification",
        "supporting_choice_refs",
        "counterevidence_choice_refs"
      ],
      "type": "object"
    },
    "trajectory_id": {
      "pattern": "^T[0-9]{4}$",
      "type": "string"
    }
  },
  "required": [
    "trajectory_id",
    "perceived_profile",
    "causal_continuity",
    "profile_coherence"
  ],
  "title": "Phase 5 individual trajectory annotation",
  "type": "object"
}
