{
  "$id": "phase5-pairwise-annotation-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparison_id": {
      "pattern": "^C[0-9]{3}_(?:AB|BA)$",
      "type": "string"
    },
    "evidence_story_a": {
      "items": {
        "pattern": "^S[0-9]{3}(?:-C[0-9]{2})?$",
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "evidence_story_b": {
      "items": {
        "pattern": "^S[0-9]{3}(?:-C[0-9]{2})?$",
        "type": "string"
      },
      "maxItems": 5,
      "type": "array"
    },
    "narrative_distinctness": {
      "additionalProperties": false,
      "properties": {
        "justification": {
          "maxLength": 1200,
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "enum": [
            "low",
            "medium",
            "high",
            "unclear"
          ],
          "type": "string"
        }
      },
      "required": [
        "label",
        "justification"
      ],
      "type": "object"
    },
    "perceived_profile_shift": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "A_more_physical",
            "similar",
            "A_more_tactical",
            "unclear"
          ],
          "type": "string"
        },
        "morality": {
          "enum": [
            "A_more_selfish",
            "similar",
            "A_more_noble",
            "unclear"
          ],
          "type": "string"
        },
        "risk": {
          "enum": [
            "A_more_cautious",
            "similar",
            "A_more_reckless",
            "unclear"
          ],
          "type": "string"
        }
      },
      "required": [
        "risk",
        "morality",
        "action"
      ],
      "type": "object"
    },
    "profile_shift_justification": {
      "maxLength": 1600,
      "minLength": 1,
      "type": "string"
    },
    "trajectory_a_id": {
      "pattern": "^T[0-9]{4}$",
      "type": "string"
    },
    "trajectory_b_id": {
      "pattern": "^T[0-9]{4}$",
      "type": "string"
    }
  },
  "required": [
    "comparison_id",
    "trajectory_a_id",
    "trajectory_b_id",
    "narrative_distinctness",
    "perceived_profile_shift",
    "profile_shift_justification",
    "evidence_story_a",
    "evidence_story_b"
  ],
  "title": "Phase 5 pairwise trajectory annotation",
  "type": "object"
}
